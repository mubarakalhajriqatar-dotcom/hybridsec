# Copy this file to .env and edit. Everything is optional; the app runs with no keys at all
# (the planner then uses the built-in rules engine).
# The file is re-read on every request, so you can paste a key here while the server is running.
# Values in this file take precedence over variables set in the process environment.

# ---- AI planner ----
# auto = use Anthropic if it has credentials (ANTHROPIC_API_KEY here, or an ANTHROPIC_AUTH_TOKEN or an
#        `ant auth login` profile in the environment), else OpenAI if OPENAI_API_KEY is set, else rules.
HYBRIDSEC_AI_PROVIDER=auto

# Anthropic (recommended)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI-compatible (OpenAI, Azure OpenAI gateway, Ollama, LM Studio, ...)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Seconds the planner allows for each connect, read and write operation of a provider request
# (not for the whole request).
HYBRIDSEC_AI_TIMEOUT=120

# ---- Server ----
# Bind address and port. run.sh / run.ps1 read them from this file unless the same variable is set in the
# shell (a shell value wins). Keep 127.0.0.1 unless you know you need LAN access.
HYBRIDSEC_HOST=127.0.0.1
HYBRIDSEC_PORT=8000
# Extra names the dashboard may be reached by (Host header allow-list against DNS rebinding).
# localhost, 127.0.0.1, ::1 and HYBRIDSEC_HOST are always accepted. Example: hybridsec.lab,192.168.1.20
HYBRIDSEC_ALLOWED_HOSTS=

# ---- Scanning safety ----
# Comma-separated allow-list. Empty = any target the operator confirms as authorized.
# Examples: 127.0.0.1,192.168.1.0/24,*.lab.example.edu
HYBRIDSEC_ALLOWED_TARGETS=
# Programs the dashboard's Custom tools page may register (comma-separated names). Empty means
# curl, dig, host, nslookup, whois, sslscan, sslyze, traceroute, tracert. Shells, interpreters,
# launchers, script files, attack tools and the built-in scanners are refused whatever this says.
HYBRIDSEC_CUSTOM_PROGRAMS=
HYBRIDSEC_MAX_TIMEOUT=900
HYBRIDSEC_DEFAULT_TIMEOUT=180
HYBRIDSEC_MAX_TOP_PORTS=1000
# How many runs may execute at the same time (extra requests get HTTP 429).
HYBRIDSEC_MAX_CONCURRENT_RUNS=3
# Simulation mode generates synthetic results so the dashboard can be demonstrated without nmap/whatweb.
HYBRIDSEC_ALLOW_SIMULATION=true

# ---- Storage ----
# HYBRIDSEC_DATA_DIR=./data
